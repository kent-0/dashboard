{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node .output/server/index.mjs",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "prepare": "husky install",
    "up:i": "pnpm up --interactive",
    "up:f": "pnpm up --latest"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.2.2",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "^9.0.0",
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/typescript": "^4.0.6",
    "@graphql-codegen/typescript-operations": "^4.2.0",
    "@julr/unocss-preset-forms": "^2.0.0",
    "@julr/unocss-preset-heropatterns": "^2.0.0",
    "@nuxt/devtools": "^1.1.5",
    "@nuxt/eslint": "^0.4.0",
    "@nuxt/eslint-config": "^0.4.0",
    "@nuxt/image": "^1.5.0",
    "@nuxtjs/apollo": "5.0.0-alpha.14",
    "@nuxtjs/color-mode": "^3.4.0",
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@nuxtjs/eslint-module": "^4.1.0",
    "@sidebase/nuxt-auth": "0.8.1",
    "@types/eslint__js": "^8.42.3",
    "@types/lint-staged": "^13.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@unocss/eslint-config": "^0.61.0",
    "@unocss/nuxt": "^0.61.0",
    "@vee-validate/nuxt": "^4.12.6",
    "@vee-validate/yup": "^4.12.6",
    "conventional-changelog-angular": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-perfectionist": "^2.9.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^9.25.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "nuxt": "^3.11.2",
    "nuxt-icon": "^0.6.10",
    "prettier": "^3.2.5",
    "typescript-eslint": "^8.0.0",
    "unocss-preset-animatecss": "^0.0.2",
    "vite-plugin-eslint2": "^5.0.0",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "pnpm": {
    "allowedDeprecatedVersions": {
      "@babel/plugin-proposal-class-properties": "7.18.6",
      "@babel/plugin-proposal-object-rest-spread": "7.20.7"
    }
  },
  "dependencies": {
    "next-auth": "~4.24.0"
  }
}
